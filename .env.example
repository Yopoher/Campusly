# Campusly — variables d'environnement (modèle sans valeurs).
# Copier vers .env.local pour le développement. Ne jamais committer de fichier .env rempli.
# En production et préproduction, ces valeurs sont saisies dans Vercel et Supabase (docs/SECURITY.md §5.5).

# --- Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Phase 3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret : côté serveur uniquement (dispatcher, import CSV, scripts d'administration)
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mails Brevo (Phase 3 et 6)
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Campusly

# --- Notifications push (Phase 6) — générer avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# --- Tâches planifiées (Phase 6) : secret partagé entre pg_cron et /api/jobs/dispatch
JOBS_DISPATCH_SECRET=

# --- Tests de base de données : serveur PostgreSQL 16+ jetable (jamais une base réelle)
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
